[Unit]
Description=Daily Liora Restic Backup Timer
Documentation=https://github.com/automation-agent-ai/multilingual-ticket-triage-devops

[Timer]
# Run daily at 02:00 UTC
OnCalendar=*-*-* 02:00:00

# If system is down during scheduled time, run on next boot
Persistent=true

# Randomize start time by up to 5 minutes to avoid exact timing conflicts
RandomizedDelaySec=5min

# Accuracy (how close to schedule we need to be)
AccuracySec=10min

[Install]
WantedBy=timers.target
