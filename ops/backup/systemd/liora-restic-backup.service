[Unit]
Description=Liora Restic Backup to Local EBS
Documentation=https://github.com/automation-agent-ai/multilingual-ticket-triage-devops
StartLimitBurst=1
StartLimitIntervalSec=1h
OnSuccess=liora-restic-offsite-copy.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
RuntimeDirectory=liora-restic-backup
RuntimeDirectoryMode=0700
WorkingDirectory=/home/ubuntu/phase11-backup-implementation/scripts

ExecStart=/home/ubuntu/phase11-backup-implementation/scripts/restic-backup.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=liora-restic-backup

TimeoutStartSec=30min
MemoryMax=2G
Restart=no

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

ReadOnlyPaths=/home/ubuntu/workspaces
ReadOnlyPaths=/home/ubuntu/phase11-backup-implementation
ReadOnlyPaths=/etc/liora-backup
ReadWritePaths=/tmp
ReadWritePaths=/var/run
ReadWritePaths=/var/backups/liora-restic

Environment="REPO_ROOT=/home/ubuntu/workspaces/multilingual-ticket-triage-devops"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="RESTIC_REPOSITORY=/var/backups/liora-restic"
Environment="RESTIC_PASSWORD_FILE=/etc/liora-backup/restic-password"

[Install]
WantedBy=multi-user.target
